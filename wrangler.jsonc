{
  "name": "catan-cities-and-knights",
  "main": "worker.js",
  "compatibility_date": "2026-04-19",
  "assets": {
    "directory": "./webapp",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ]
}
